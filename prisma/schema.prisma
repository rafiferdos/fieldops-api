generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  GOOGLE
}

enum Currency {
  BDT
}

model Service {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(100)
  description    String    @db.VarChar(2000)
  basePriceMinor Int
  currency       Currency  @default(BDT)
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([deletedAt, createdAt, id])
  @@index([deletedAt, basePriceMinor, id])
}

// Durable cache generation; incremented in every catalog write transaction.
model CatalogRevision {
  id       Int    @id
  revision BigInt @default(0)
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  phone        String?
  passwordHash String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  deletedAt    DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  identities   AuthIdentity[]
  auditLogs    AuditLog[]

  @@index([role, status])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(50)
  entityId   String   @db.Uuid
  metadata   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model AuthIdentity {
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  userId          String       @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([provider, providerSubject])
  @@unique([userId, provider])
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  expiresAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  tokenHash  String    @id @db.Char(64)
  sessionId  String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([expiresAt])
}
