generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  GOOGLE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  phone        String?
  passwordHash String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  deletedAt    DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  identities   AuthIdentity[]

  @@index([role, status])
}

model AuthIdentity {
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  userId          String       @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([provider, providerSubject])
  @@unique([userId, provider])
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  expiresAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  tokenHash  String    @id @db.Char(64)
  sessionId  String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([expiresAt])
}
