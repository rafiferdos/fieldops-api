// One immutable customer submission per completed, paid work order.
model Feedback {
  id          String    @id @default(uuid()) @db.Uuid
  workOrderId String    @unique @db.Uuid
  customerId  String    @db.Uuid
  rating      Int       @db.SmallInt
  comment     String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  customer    User      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt, id])
}
