NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001

POSTGRES_PASSWORD=fieldops_dev_password
DATABASE_URL=postgresql://fieldops:fieldops_dev_password@localhost:5432/fieldops?schema=public
TEST_DATABASE_URL=postgresql://fieldops:fieldops_dev_password@localhost:5432/fieldops_test?schema=public
REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6379/1
JWT_ACCESS_SECRET=replace_with_a_random_64_byte_base64_secret

# Optional until Google login is configured; OAuth Web Client ID, not a secret.
GOOGLE_CLIENT_ID=

# Optional: dedicated admin bootstrap (never commit actual credentials).
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=FieldOps Admin

# Optional: dedicated technician bootstrap; existing accounts are never promoted/reset.
# SEED_TECHNICIAN_EMAIL=technician@example.com
# SEED_TECHNICIAN_PASSWORD=
# SEED_TECHNICIAN_NAME=FieldOps Technician

# Optional: configure all four together to enable payments. Keep merchant secrets private.
# PUBLIC_API_URL must be a publicly reachable HTTPS origin; no /api/v1 suffix.
# Local non-production sandbox browser tests may use http://localhost:3000.
# Loopback does not receive provider server IPN. Never use it for live/production.
SSLCOMMERZ_MODE=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
PUBLIC_API_URL=
